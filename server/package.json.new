{
  "name": "almutanabbi-server",
  "version": "1.0.0",
  "description": "Backend API for Al-Mutanabbi Iraqi bookstore marketplace",
  "main": "server.js",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "migrate": "node migrations/run-migrations.js",
    "seed": "node scripts/seed-database.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "bookstore",
    "marketplace",
    "iraq",
    "almutanabbi",
    "books"
  ],
  "author": "Al-Mutanabbi Team",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "sequelize": "^6.35.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "nodemailer": "^6.9.7",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
